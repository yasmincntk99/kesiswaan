{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/api/ai-catat",
      "destination": "/api/layanan?op=ai-catat"
    },
    {
      "source": "/api/eksekutif",
      "destination": "/api/layanan?op=eksekutif"
    },
    {
      "source": "/api/perapian",
      "destination": "/api/layanan?op=perapian"
    },
    {
      "source": "/api/qr",
      "destination": "/api/layanan?op=qr"
    },
    {
      "source": "/api/ringkasan",
      "destination": "/api/layanan?op=ringkasan"
    },
    {
      "source": "/api/tanya",
      "destination": "/api/layanan?op=tanya"
    },
    {
      "source": "/api/walikelas",
      "destination": "/api/layanan?op=walikelas"
    }
  ]
}
